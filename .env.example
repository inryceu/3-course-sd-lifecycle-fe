# Build-time configuration (Vite reads VITE_* when building/serving).
# Copy to .env.local for local development.

# REST base URL of the backend (include the /api/v1 prefix).
VITE_API_URL=http://localhost:3000/api/v1

# Origin of the Socket.IO server; the client connects to <origin>/realtime.
# Leave empty to use the page origin (Vite proxies /socket.io in development).
VITE_WS_URL=
